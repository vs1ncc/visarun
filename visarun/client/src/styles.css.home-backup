@font-face {
  font-family: "Ethna Demo";
  src: url("./assets/fonts/Ethna_Demo.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

* {
  box-sizing: border-box;
}

:root {
  --bg: #08080b;
  --surface: #101014;
  --surface-2: #141419;
  --surface-3: #19181f;
  --border: rgba(255,255,255,.075);
  --border-light: rgba(255,255,255,.11);

  --text: #f5f4f7;
  --text-2: #c5c1ca;
  --muted: #85818c;
  --muted-2: #66626c;

  --purple: #a855f7;
  --purple-light: #c084fc;
  --purple-soft: rgba(168,85,247,.12);

  --green: #71d59a;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
  background: var(--bg);
}

body {
  color: var(--text);
  font-family:
    "Ethna Demo",
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Display",
    "SF Pro Text",
    "Segoe UI",
    sans-serif;

  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  color: inherit;
  border: 0;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

input {
  color: var(--text);
}

.app {
  width: 100%;
  max-width: 430px;
  min-height: 100vh;
  margin: 0 auto;
  padding-bottom: 100px;
}

.content {
  width: 100%;
  max-width: 430px;
  min-height: 100vh;
  margin: 0 auto;
  padding: 20px 16px 120px;
}

/* =========================================================
   HOME
   ========================================================= */

.home-page {
  width: 100%;
}

.top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: 0 2px 27px;
  padding-top: 2px;
}

.brand-block {
  min-width: 0;
}

.eyebrow {
  margin-bottom: 5px;

  color: var(--purple-light);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 2px;
}

.top-header h1 {
  margin: 0;

  color: var(--text);
  font-size: 31px;
  line-height: .98;
  font-weight: 760;
  letter-spacing: -1.4px;
}

.top-header p {
  margin: 8px 0 0;

  color: var(--muted);
  font-size: 12px;
  line-height: 1.35;
}

.telegram-avatar {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  color: white;
  font-size: 16px;
  font-weight: 700;

  background:
    linear-gradient(
      145deg,
      #bd73f7,
      #7d3dd1
    );

  box-shadow:
    0 8px 25px rgba(168,85,247,.18),
    inset 0 1px 0 rgba(255,255,255,.22);

  border: 1px solid rgba(255,255,255,.12);
}

/* =========================================================
   HERO
   ========================================================= */

.hero {
  position: relative;

  min-height: 210px;
  margin-bottom: 30px;
  padding: 24px 21px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  overflow: hidden;

  border-radius: 25px;
  border: 1px solid rgba(192,132,252,.13);

  background:
    radial-gradient(
      circle at 88% 8%,
      rgba(168,85,247,.22),
      transparent 31%
    ),
    linear-gradient(
      145deg,
      #1d1328 0%,
      #121016 53%,
      #0e0e12 100%
    );

  box-shadow:
    0 20px 55px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.045);
}

.hero-glow {
  position: absolute;

  width: 230px;
  height: 230px;

  right: -130px;
  top: -130px;

  border-radius: 50%;

  background: rgba(168,85,247,.2);
  filter: blur(42px);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-label {
  display: block;
  margin-bottom: 16px;

  color: #bd80f2;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 1.5px;
}

.hero h2 {
  max-width: 290px;
  margin: 0;

  color: white;
  font-size: 27px;
  line-height: 1.06;
  font-weight: 760;
  letter-spacing: -1px;
}

.hero p {
  max-width: 255px;
  margin: 13px 0 0;

  color: rgba(255,255,255,.48);
  font-size: 12px;
  line-height: 1.5;
}

.hero-orb {
  position: absolute;

  right: 19px;
  bottom: 19px;

  width: 45px;
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(168,85,247,.1);
  border: 1px solid rgba(192,132,252,.17);
}

.hero-orb span {
  color: var(--purple-light);
  font-size: 19px;
}

/* =========================================================
   SECTION TITLES
   ========================================================= */

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  margin: 0 2px 13px;
}

.section-heading > div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-heading > div > span {
  display: none;
}

.section-heading h2 {
  margin: 0;

  color: var(--text);
  font-size: 19px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -.5px;
}

.section-heading p {
  margin: 0 1px 1px;

  color: var(--muted-2);
  font-size: 10px;
}

/* =========================================================
   ROUTES
   ========================================================= */

.routes-list {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.route-card {
  width: 100%;
  min-height: 112px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;

  padding: 17px;

  text-align: left;

  border-radius: 22px;
  border: 1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.045),
      rgba(255,255,255,.016)
    );

  box-shadow:
    0 10px 30px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,.025);

  transition:
    transform .16s ease,
    border-color .16s ease,
    background .16s ease;
}

.route-card:active {
  transform: scale(.985);

  border-color: rgba(168,85,247,.4);

  background:
    linear-gradient(
      145deg,
      rgba(168,85,247,.10),
      rgba(255,255,255,.018)
    );
}

.route-card-main {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 14px;
}

.route-icon {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background: rgba(168,85,247,.09);
  border: 1px solid rgba(192,132,252,.12);
}

.route-icon span {
  font-size: 24px;
  line-height: 1;
}

.route-copy {
  min-width: 0;
}

.route-name {
  display: block;
  margin-bottom: 5px;

  color: #77727d;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .3px;
}

.route-copy h3 {
  margin: 0 0 5px;

  color: var(--text);
  font-size: 17px;
  line-height: 1.05;
  font-weight: 700;
  letter-spacing: -.35px;
}

.route-copy p {
  margin: 0;

  color: var(--muted);
  font-size: 11px;
  line-height: 1.35;
}

.route-arrow {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.045);
}

.route-arrow span {
  color: var(--purple-light);
  font-size: 17px;
}

/* =========================================================
   INNER PAGE HEADERS
   ========================================================= */

.page-header {
  margin: 3px 2px 25px;
}

.page-kicker {
  display: none;
}

.page-header h1 {
  margin: 0;

  color: var(--text);
  font-size: 31px;
  line-height: 1;
  font-weight: 760;
  letter-spacing: -1.25px;
}

.page-header p {
  margin: 9px 0 0;

  color: var(--muted);
  font-size: 12px;
}

/* =========================================================
   BOOKINGS
   ========================================================= */

.bookings-page {
  width: 100%;
}

.bookings-list {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.booking-card {
  padding: 18px;

  border-radius: 22px;
  border: 1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.045),
      rgba(255,255,255,.015)
    );

  box-shadow:
    0 12px 32px rgba(0,0,0,.19),
    inset 0 1px 0 rgba(255,255,255,.025);
}

.booking-route-line {
  display: flex;
  align-items: center;
  gap: 11px;

  margin-bottom: 17px;
}

.booking-route-dot {
  width: 9px;
  height: 9px;
  flex: 0 0 9px;

  border-radius: 50%;

  background: var(--purple-light);
  box-shadow: 0 0 14px rgba(168,85,247,.55);
}

.booking-route-line span {
  display: block;
  margin-bottom: 4px;

  color: var(--muted-2);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.booking-route-line h3 {
  margin: 0;

  color: var(--text);
  font-size: 18px;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: -.45px;
}

.booking-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.booking-details > div {
  padding: 11px 12px;

  border-radius: 14px;

  background: rgba(255,255,255,.025);
  border: 1px solid rgba(255,255,255,.04);
}

.booking-details span {
  display: block;
  margin-bottom: 5px;

  color: var(--muted-2);
  font-size: 9px;
}

.booking-details strong {
  display: block;

  color: var(--text-2);
  font-size: 12px;
  line-height: 1.25;
  font-weight: 600;
}

.booking-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 14px;
  padding-top: 13px;

  border-top: 1px solid rgba(255,255,255,.05);
}

.booking-bottom span {
  color: var(--muted-2);
  font-size: 10px;
}

.booking-bottom strong {
  color: var(--purple-light);
  font-size: 15px;
  font-weight: 700;
}

.empty-bookings {
  min-height: 280px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  border-radius: 24px;

  background: rgba(255,255,255,.018);
  border: 1px solid rgba(255,255,255,.045);
}

.empty-mark {
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 17px;

  border-radius: 17px;

  background: rgba(168,85,247,.08);
  border: 1px solid rgba(192,132,252,.12);
}

.empty-mark span {
  color: var(--purple-light);
  font-size: 21px;
}

.empty-bookings h3 {
  margin: 0 0 7px;

  color: var(--text);
  font-size: 16px;
  font-weight: 700;
}

.empty-bookings p {
  max-width: 210px;
  margin: 0;

  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   PROFILE
   ========================================================= */

.profile-page {
  width: 100%;
}

.profile-identity {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 11px;
  padding: 18px;

  border-radius: 23px;

  background:
    linear-gradient(
      145deg,
      rgba(168,85,247,.11),
      rgba(255,255,255,.025)
    );

  border: 1px solid rgba(192,132,252,.12);

  box-shadow:
    0 14px 35px rgba(0,0,0,.18),
    inset 0 1px 0 rgba(255,255,255,.04);
}

.profile-avatar {
  width: 55px;
  height: 55px;
  flex: 0 0 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(192,132,252,.32),
      rgba(124,58,237,.18)
    );

  border: 1px solid rgba(192,132,252,.2);

  color: white;
  font-size: 20px;
  font-weight: 700;
}

.profile-identity-copy {
  min-width: 0;
}

.profile-identity-copy > span {
  display: none;
}

.profile-identity-copy strong {
  display: block;

  color: var(--text);
  font-size: 17px;
  line-height: 1.1;
  font-weight: 700;
}

.profile-identity-copy p {
  margin: 5px 0 0;

  color: var(--muted);
  font-size: 11px;
}

.profile-section {
  margin-bottom: 10px;
  padding: 6px 15px;

  border-radius: 21px;

  background: rgba(255,255,255,.022);
  border: 1px solid rgba(255,255,255,.055);
}

.profile-section-heading {
  padding: 8px 0 3px;
}

.section-number {
  display: none;
}

.profile-section-heading h3 {
  margin: 0;

  color: var(--muted-2);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .7px;
  text-transform: uppercase;
}

.profile-row {
  min-height: 49px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  border-bottom: 1px solid rgba(255,255,255,.045);
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-row > span {
  color: var(--muted);
  font-size: 12px;
}

.profile-row > strong {
  max-width: 62%;

  color: var(--text-2);
  font-size: 12px;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.profile-empty {
  margin: 10px 0 12px;

  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

.legal-card {
  margin-top: 14px;
  padding: 16px;

  border-radius: 21px;

  background: rgba(255,255,255,.018);
  border: 1px solid rgba(255,255,255,.05);
}

.legal-card > div:first-child > span {
  display: block;
  margin-bottom: 5px;

  color: var(--muted-2);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .7px;
}

.legal-card > div:first-child > strong {
  color: var(--text-2);
  font-size: 12px;
  font-weight: 600;
}

.legal-buttons {
  display: flex;
  flex-direction: column;

  margin-top: 12px;
}

.legal-buttons button {
  min-height: 43px;
  padding: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--text-2);
  text-align: left;
  font-size: 11px;

  background: transparent;
  border-top: 1px solid rgba(255,255,255,.045);
}

.legal-buttons button span {
  color: var(--purple-light);
  font-size: 16px;
}

/* =========================================================
   BACK BUTTON
   ========================================================= */

.back-button {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 18px;

  border-radius: 13px;

  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.06);

  color: var(--text-2);
}

/* =========================================================
   SERVICE SELECTION
   ========================================================= */

.subtitle {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

.service-card {
  width: 100%;
  margin-bottom: 10px;
  padding: 17px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  text-align: left;

  border-radius: 21px;
  border: 1px solid var(--border);

  background: var(--surface);
}

.service-card:active {
  border-color: rgba(168,85,247,.4);
  background: var(--purple-soft);
}

.service-card h3 {
  margin: 0 0 5px;
  font-size: 16px;
}

.service-card p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.price-vnd {
  color: var(--muted);
  font-size: 10px;
}

.price-rub {
  color: var(--purple-light);
  font-size: 16px;
  font-weight: 700;
}

/* =========================================================
   FORMS / PASSPORT
   ========================================================= */

.form {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.form label {
  color: var(--muted);
  font-size: 11px;
}

input:not([type]) {
  width: 100%;
  min-height: 50px;

  padding: 0 14px;

  border-radius: 15px;

  color: var(--text);
  background: var(--surface);
  border: 1px solid var(--border);
  outline: none;
}

input:focus {
  border-color: rgba(168,85,247,.5);
  box-shadow: 0 0 0 3px rgba(168,85,247,.08);
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 9px;

  color: var(--muted);
  font-size: 11px;
  line-height: 1.45;
}

.consent input {
  margin-top: 2px;
}

.link-button {
  color: var(--purple-light);
  background: transparent;
  padding: 0;
}

/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

.primary-button {
  width: 100%;
  min-height: 52px;

  margin-top: 7px;

  border-radius: 16px;

  color: white;
  font-size: 13px;
  font-weight: 700;

  background:
    linear-gradient(
      135deg,
      #aa5af2,
      #873fd0
    );

  box-shadow:
    0 10px 28px rgba(168,85,247,.18),
    inset 0 1px 0 rgba(255,255,255,.15);
}

.primary-button:active {
  transform: scale(.985);
}

.primary-button:disabled {
  opacity: .35;
  box-shadow: none;
}

/* =========================================================
   RECOMMENDATIONS
   ========================================================= */

.recommendation {
  margin: 13px 0;
  padding: 15px;

  border-radius: 18px;

  background: rgba(168,85,247,.055);
  border: 1px solid rgba(168,85,247,.10);
}

.recommendation strong {
  display: block;
  margin-bottom: 5px;
  font-size: 12px;
}

.recommendation p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   BUS / SEATS
   ========================================================= */

.bus {
  width: 100%;
  padding: 14px;

  border-radius: 23px;

  background: var(--surface);
  border: 1px solid var(--border);
}

.bus-header {
  margin-bottom: 13px;
  color: var(--muted);
  font-size: 11px;
}

.bus-floor {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 7px;
}

.seat {
  min-height: 39px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  color: var(--text-2);
  font-size: 10px;

  background: rgba(255,255,255,.035);
  border: 1px solid rgba(255,255,255,.05);
}

.seat.selected {
  color: white;
  background: rgba(168,85,247,.3);
  border-color: rgba(192,132,252,.45);
}

.seat.taken {
  opacity: .25;
}

.seat-legend {
  display: flex;
  gap: 15px;
  margin-top: 13px;
}

.seat-legend span {
  display: flex;
  align-items: center;
  gap: 5px;
  color: var(--muted);
  font-size: 9px;
}

.seat-legend i {
  width: 8px;
  height: 8px;
  display: block;
  border-radius: 3px;
}

.free {
  background: rgba(255,255,255,.12);
}

.selected-dot {
  background: var(--purple-light);
}

.taken-dot {
  background: rgba(255,255,255,.03);
}

/* =========================================================
   PAYMENT
   ========================================================= */

.timer-card {
  margin-bottom: 12px;
  padding: 16px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-radius: 18px;

  background: rgba(168,85,247,.07);
  border: 1px solid rgba(168,85,247,.11);
}

.timer-card span {
  color: var(--muted);
  font-size: 11px;
}

.timer-card strong {
  color: var(--purple-light);
  font-size: 20px;
}

.order-summary {
  margin-bottom: 13px;
  padding: 16px;

  border-radius: 19px;

  background: var(--surface);
  border: 1px solid var(--border);
}

.order-summary span {
  color: var(--muted);
  font-size: 11px;
}

.order-summary strong:last-child {
  color: var(--purple-light);
}

.payment-methods {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 13px;
}

.payment-method {
  width: 100%;
  padding: 15px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  text-align: left;

  border-radius: 17px;

  background: var(--surface);
  border: 1px solid var(--border);
}

.payment-method.active {
  border-color: rgba(168,85,247,.35);
  background: rgba(168,85,247,.07);
}

.payment-method.disabled {
  opacity: .38;
}

.payment-method small {
  color: var(--muted);
}

.bank-card {
  margin-bottom: 13px;
  padding: 17px;

  border-radius: 19px;

  background: var(--surface);
  border: 1px solid var(--border);
}

.bank-card > span {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 10px;
}

.bank-card > strong {
  display: block;
  margin-bottom: 13px;
  font-size: 17px;
}

.recipient {
  color: var(--text-2);
  font-size: 12px;
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;

  margin-top: 12px;
}

.copy-button {
  padding: 8px 10px;
  border-radius: 10px;

  color: var(--purple-light);
  background: rgba(168,85,247,.08);
}

.upload-card {
  margin-bottom: 13px;
  padding: 17px;

  border-radius: 19px;

  background: var(--surface);
  border: 1px solid var(--border);
}

.upload-card h3 {
  margin: 0 0 6px;
  font-size: 14px;
}

.upload-card p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

.file-selected {
  margin-top: 11px;
  color: var(--purple-light);
  font-size: 11px;
}

/* =========================================================
   LEGACY BOOKING ELEMENTS
   ========================================================= */

.booking-top {
  display: flex;
  justify-content: space-between;
}

.status {
  display: none;
}

.booking-price {
  color: var(--purple-light);
  font-weight: 700;
}

/* =========================================================
   LEGAL
   ========================================================= */

.legal-links {
  display: flex;
  flex-direction: column;
  gap: 0;

  margin-top: 14px;
}

.legal-links button {
  min-height: 45px;

  display: flex;
  align-items: center;

  color: var(--text-2);
  text-align: left;

  background: transparent;
  border-bottom: 1px solid rgba(255,255,255,.05);
}

/* =========================================================
   BOTTOM NAV
   ========================================================= */

.bottom-nav {
  position: fixed !important;

  z-index: 100;

  width: min(398px, calc(100% - 24px)) !important;

  left: 50% !important;
  right: auto !important;
  bottom: max(10px, env(safe-area-inset-bottom)) !important;

  transform: translateX(-50%);

  padding: 6px !important;

  display: flex;

  border-radius: 23px !important;

  background: rgba(17,17,22,.9) !important;

  border: 1px solid rgba(255,255,255,.09) !important;

  box-shadow:
    0 20px 55px rgba(0,0,0,.55),
    inset 0 1px 0 rgba(255,255,255,.045) !important;

  backdrop-filter: blur(26px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(26px) saturate(140%) !important;
}

.bottom-nav button {
  min-height: 52px;
  flex: 1;

  border-radius: 18px !important;

  background: transparent !important;
}

.bottom-nav button.active {
  background:
    linear-gradient(
      145deg,
      rgba(168,85,247,.2),
      rgba(168,85,247,.09)
    ) !important;

  box-shadow:
    inset 0 0 0 1px rgba(192,132,252,.08);
}

.bottom-nav svg {
  width: 19px;
  height: 19px;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 430px) {
  .content {
    padding-left: 15px;
    padding-right: 15px;
  }
}

@media (max-width: 360px) {
  .content {
    padding-left: 12px;
    padding-right: 12px;
  }

  .hero h2 {
    font-size: 24px;
  }

  .booking-details {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   FINAL BOTTOM NAV FIX
   ========================================================= */

.bottom-nav {
  position: fixed !important;
  z-index: 9999 !important;

  left: 50% !important;
  right: auto !important;
  bottom: calc(10px + env(safe-area-inset-bottom)) !important;

  width: min(398px, calc(100% - 24px)) !important;
  height: 70px !important;

  transform: translateX(-50%) !important;

  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;

  padding: 6px !important;

  background: rgba(18, 18, 24, .94) !important;

  border: 1px solid rgba(255,255,255,.10) !important;
  border-radius: 23px !important;

  box-shadow:
    0 18px 50px rgba(0,0,0,.55),
    inset 0 1px 0 rgba(255,255,255,.06) !important;

  backdrop-filter: blur(25px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(25px) saturate(150%) !important;

  overflow: hidden !important;
}

.bottom-nav button {
  position: relative !important;

  width: 33.333% !important;
  height: 58px !important;
  min-height: 58px !important;
  flex: 1 1 33.333% !important;

  margin: 0 !important;
  padding: 5px 4px !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4px !important;

  color: #77737d !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 18px !important;

  box-shadow: none !important;

  transition:
    background .18s ease,
    color .18s ease,
    transform .18s ease !important;
}

.bottom-nav button.active {
  color: #eeeaf3 !important;

  background:
    linear-gradient(
      145deg,
      rgba(168,85,247,.24),
      rgba(168,85,247,.11)
    ) !important;

  box-shadow:
    inset 0 0 0 1px rgba(192,132,252,.08) !important;
}

.bottom-nav button:active {
  transform: scale(.96) !important;
}

.bottom-nav button svg {
  width: 19px !important;
  height: 19px !important;

  margin: 0 !important;

  stroke-width: 1.7 !important;
}

.bottom-nav button.active svg {
  color: #c084fc !important;
}

.bottom-nav button small {
  display: block !important;

  margin: 0 !important;

  color: inherit !important;

  font-size: 9px !important;
  line-height: 1 !important;
  font-weight: 600 !important;

  white-space: nowrap !important;
}

/* На узких экранах чуть компактнее */
@media (max-width: 360px) {
  .bottom-nav {
    width: calc(100% - 18px) !important;
    height: 67px !important;
  }

  .bottom-nav button {
    height: 55px !important;
    min-height: 55px !important;
  }

  .bottom-nav button small {
    font-size: 8px !important;
  }
}

/* =========================================================
   BOTTOM BAR — CURRENT JSX
   ========================================================= */

.bottom-bar {
  position: fixed !important;
  z-index: 9999 !important;

  left: 50% !important;
  bottom: calc(12px + env(safe-area-inset-bottom)) !important;
  transform: translateX(-50%) !important;

  width: min(400px, calc(100% - 24px)) !important;
  height: 72px !important;

  display: flex !important;
  align-items: center !important;
  gap: 5px !important;

  padding: 6px !important;

  background: rgba(18, 18, 24, 0.94) !important;
  border: 1px solid rgba(255, 255, 255, 0.10) !important;
  border-radius: 24px !important;

  box-shadow:
    0 18px 50px rgba(0, 0, 0, .50),
    inset 0 1px 0 rgba(255,255,255,.055) !important;

  backdrop-filter: blur(26px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(26px) saturate(150%) !important;

  overflow: hidden !important;
}

.bottom-bar button {
  flex: 1 1 0 !important;

  width: 0 !important;
  height: 58px !important;
  min-height: 58px !important;

  margin: 0 !important;
  padding: 5px 4px !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 5px !important;

  background: transparent !important;
  color: #77727e !important;

  border: 0 !important;
  border-radius: 18px !important;

  font-size: 18px !important;

  transition:
    background .18s ease,
    color .18s ease,
    transform .18s ease !important;
}

.bottom-bar button span {
  display: block !important;

  height: 20px !important;
  line-height: 20px !important;

  font-size: 19px !important;
  font-weight: 400 !important;
}

.bottom-bar button small {
  display: block !important;

  margin: 0 !important;
  padding: 0 !important;

  color: inherit !important;

  font-size: 9px !important;
  line-height: 11px !important;
  font-weight: 600 !important;

  white-space: nowrap !important;
}

.bottom-bar button.nav-active {
  color: #f1edf5 !important;

  background:
    linear-gradient(
      145deg,
      rgba(168, 85, 247, .24),
      rgba(168, 85, 247, .11)
    ) !important;

  box-shadow:
    inset 0 0 0 1px rgba(192,132,252,.08) !important;
}

.bottom-bar button.nav-active span {
  color: #c084fc !important;
}

.bottom-bar button:active {
  transform: scale(.96) !important;
}

@media (max-width: 360px) {
  .bottom-bar {
    width: calc(100% - 18px) !important;
    height: 68px !important;
  }

  .bottom-bar button {
    height: 54px !important;
    min-height: 54px !important;
  }

  .bottom-bar button small {
    font-size: 8px !important;
  }
}


/* =========================================================
   BOTTOM BAR — PREMIUM SVG ICONS
   ========================================================= */

.bottom-bar button .nav-icon {
  width: 22px;
  height: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #77737d;

  transition:
    color .18s ease,
    transform .18s ease;
}

.bottom-bar button .nav-icon svg {
  width: 21px;
  height: 21px;

  display: block;

  stroke: currentColor;
  stroke-width: 1.65;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.bottom-bar button.nav-active .nav-icon {
  color: #c084fc;
}

.bottom-bar button:active .nav-icon {
  transform: scale(.92);
}

.bottom-bar button small {
  margin-top: 2px;
}

@media (max-width: 360px) {
  .bottom-bar button .nav-icon {
    width: 21px;
    height: 21px;
  }

  .bottom-bar button .nav-icon svg {
    width: 20px;
    height: 20px;
  }
}


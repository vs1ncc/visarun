/* ---------- Убираем горизонтальный скролл ---------- */

html,
body,
#root {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

button,
input {
  font-family: inherit;
}

/* =========================================================
   FESTO VIZARAN — COMPLETE MOBILE UI
   ========================================================= */

:root {
  --festo-bg: #08080b;
  --festo-card: #111116;
  --festo-card-2: #15131b;
  --festo-border: rgba(255,255,255,.075);
  --festo-text: #f5f3f7;
  --festo-muted: #8d8995;
  --festo-soft: #b8b3c0;
  --festo-purple: #a855f7;
  --festo-purple-light: #c084fc;
}

/* ---------- APP ---------- */

html,
body,
#root {
  min-height: 100%;
  background: var(--festo-bg);
}

body {
  margin: 0;
  color: var(--festo-text);
  -webkit-font-smoothing: antialiased;
}

.app {
  width: 100%;
  max-width: 430px;
  margin: 0 auto;
  min-height: 100vh;
  padding-bottom: 105px;
}

.content {
  width: 100%;
  max-width: 430px;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 20px 17px 120px;
}

/* ---------- HOME HEADER ---------- */

.home-page .top-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 0 0 24px;
  padding: 3px 2px 0;
}

.brand-block .eyebrow {
  margin: 0 0 5px;
  color: var(--festo-purple-light);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.brand-block h1 {
  margin: 0;
  font-size: 31px;
  line-height: 1;
  letter-spacing: -1.3px;
  font-weight: 780;
}

.brand-block p {
  margin: 8px 0 0;
  color: var(--festo-muted);
  font-size: 12px;
  line-height: 1.35;
}

.telegram-avatar {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  border-radius: 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #fff;
  font-size: 16px;
  font-weight: 750;

  background:
    linear-gradient(145deg,
      rgba(192,132,252,.95),
      rgba(124,58,237,.85)
    );

  border: 1px solid rgba(255,255,255,.13);
  box-shadow:
    0 9px 24px rgba(168,85,247,.20),
    inset 0 1px 0 rgba(255,255,255,.25);
}

/* ---------- HERO ---------- */

.hero {
  position: relative;
  min-height: 194px;
  box-sizing: border-box;
  margin: 0 0 29px;
  padding: 23px 21px;

  border-radius: 25px;
  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #241536 0%,
      #151019 56%,
      #0f0e13 100%
    );

  border: 1px solid rgba(192,132,252,.17);

  box-shadow:
    0 18px 45px rgba(0,0,0,.30),
    inset 0 1px 0 rgba(255,255,255,.055);
}

.hero-glow {
  position: absolute;
  width: 210px;
  height: 210px;
  right: -95px;
  top: -110px;

  border-radius: 50%;
  background: rgba(168,85,247,.26);
  filter: blur(35px);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 285px;
}

.hero-label {
  display: inline-block;
  margin-bottom: 14px;

  color: #c084fc;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.65px;
}

.hero h2 {
  margin: 0;
  color: #fff;
  font-size: 25px;
  line-height: 1.08;
  letter-spacing: -.8px;
  font-weight: 760;
}

.hero p {
  max-width: 245px;
  margin: 13px 0 0;

  color: rgba(255,255,255,.53);
  font-size: 12px;
  line-height: 1.5;
}

.hero-orb {
  position: absolute;
  right: 20px;
  bottom: 19px;

  width: 48px;
  height: 48px;
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(168,85,247,.12);
  border: 1px solid rgba(192,132,252,.18);
}

.hero-orb span {
  color: #c084fc;
  font-size: 20px;
}

/* ---------- SECTION HEADING ---------- */

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 2px 13px;
}

.section-heading > div {
  display: flex;
  align-items: center;
  gap: 9px;
}

.section-heading > div > span {
  color: #9d75c0;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}

.section-heading h2 {
  margin: 0;
  font-size: 17px;
  line-height: 1;
  letter-spacing: -.35px;
}

.section-heading p {
  margin: 0 1px 1px 0;
  color: #696570;
  font-size: 10px;
}

/* ---------- ROUTES ---------- */

.routes-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.route-card {
  position: relative;

  width: 100%;
  min-height: 104px;
  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  padding: 17px;

  text-align: left;
  color: #fff;

  border-radius: 21px;
  border: 1px solid var(--festo-border);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.055),
      rgba(255,255,255,.018)
    );

  box-shadow:
    0 10px 28px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.025);

  transition:
    transform .18s ease,
    border-color .18s ease,
    background .18s ease;
}

.route-card:active {
  transform: scale(.985);
  border-color: rgba(192,132,252,.35);
  background: rgba(168,85,247,.08);
}

.route-card-main {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 13px;
}

.route-icon {
  width: 45px;
  height: 45px;
  flex: 0 0 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background: rgba(168,85,247,.10);
  border: 1px solid rgba(192,132,252,.13);
}

.route-icon span {
  color: #c084fc;
  font-size: 16px;
  font-weight: 750;
}

.route-copy {
  min-width: 0;
}

.route-name {
  display: block;
  margin-bottom: 4px;

  color: #77727e;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .65px;
  text-transform: uppercase;
}

.route-copy h3 {
  margin: 0 0 5px;

  color: #f4f2f6;
  font-size: 16px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -.25px;
}

.route-copy p {
  margin: 0;

  color: #817c88;
  font-size: 11px;
  line-height: 1.3;
}

.route-arrow {
  width: 31px;
  height: 31px;
  flex: 0 0 31px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  background: rgba(255,255,255,.045);
}

.route-arrow span {
  color: #c084fc;
  font-size: 16px;
}

/* ---------- INNER PAGE HEADER ---------- */

.page-header {
  margin: 1px 2px 24px;
}

.page-kicker {
  display: block;
  margin-bottom: 8px;

  color: #8f61b5;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.55px;
}

.page-header h1 {
  margin: 0;

  color: #f6f4f8;
  font-size: 29px;
  line-height: 1;
  letter-spacing: -1px;
  font-weight: 780;
}

.page-header p {
  margin: 9px 0 0;
  color: #77727e;
  font-size: 12px;
}

/* ---------- BOOKINGS ---------- */

.bookings-list {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.booking-card {
  position: relative;

  padding: 18px;
  box-sizing: border-box;

  border-radius: 21px;
  border: 1px solid rgba(255,255,255,.07);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.055),
      rgba(255,255,255,.018)
    );

  box-shadow:
    0 13px 35px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.035);
}

.booking-route-line {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 17px;
}

.booking-route-dot {
  width: 9px;
  height: 9px;
  flex: 0 0 9px;

  border-radius: 50%;
  background: #b56df7;
  box-shadow: 0 0 15px rgba(168,85,247,.65);
}

.booking-route-line span {
  display: block;
  margin-bottom: 4px;
  color: #8d5bb0;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.booking-route-line h3 {
  margin: 0;
  font-size: 17px;
  line-height: 1.1;
  letter-spacing: -.35px;
}

.booking-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.booking-details > div {
  padding: 11px 12px;
  border-radius: 14px;
  background: rgba(255,255,255,.035);
  border: 1px solid rgba(255,255,255,.045);
}

.booking-details span {
  display: block;
  margin-bottom: 5px;
  color: #706b77;
  font-size: 9px;
}

.booking-details strong {
  display: block;
  color: #e5e1e8;
  font-size: 12px;
  line-height: 1.25;
  font-weight: 650;
}

.booking-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 13px;
  padding-top: 13px;

  border-top: 1px solid rgba(255,255,255,.055);
}

.booking-bottom span {
  color: #706b77;
  font-size: 10px;
}

.booking-bottom strong {
  color: #c084fc;
  font-size: 15px;
}

.empty-bookings {
  min-height: 270px;
  box-sizing: border-box;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  border-radius: 24px;
  border: 1px dashed rgba(255,255,255,.075);
  background: rgba(255,255,255,.018);
}

.empty-mark {
  width: 48px;
  height: 48px;
  margin-bottom: 17px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background: rgba(168,85,247,.10);
  border: 1px solid rgba(192,132,252,.12);
}

.empty-mark span {
  color: #bd7bf7;
  font-size: 20px;
}

.empty-bookings h3 {
  margin: 0 0 7px;
  font-size: 15px;
}

.empty-bookings p {
  max-width: 210px;
  margin: 0;
  color: #706b77;
  font-size: 11px;
  line-height: 1.5;
}


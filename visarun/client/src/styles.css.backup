* {
  box-sizing: border-box;
}

:root {
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Display",
    "SF Pro Text",
    Inter,
    Arial,
    sans-serif;

  color: #f7f7fa;
  background: #07070b;

  --purple: #a855f7;
  --purple-light: #c084fc;
  --purple-dark: #7e22ce;

  --glass: rgba(255, 255, 255, 0.07);
  --border: rgba(255, 255, 255, 0.1);
  --muted: #9b9ba5;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  background:
    radial-gradient(
      circle at 50% -20%,
      rgba(168, 85, 247, 0.18),
      transparent 40%
    ),
    #07070b;
}

body {
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.app {
  min-height: 100vh;
  padding-bottom: 105px;
}

.content {
  width: min(680px, 100%);
  margin: auto;
  padding:
    calc(env(safe-area-inset-top) + 22px)
    18px
    30px;
}

/* HEADER */

.top-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
}

.eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.18em;
  color: var(--purple-light);
  margin-bottom: 6px;
}

h1 {
  margin: 0;
  font-size: 31px;
  letter-spacing: -0.04em;
}

.top-header p {
  margin: 8px 0 0;
  color: var(--muted);
}

.telegram-avatar,
.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      145deg,
      #c084fc,
      #7e22ce
    );

  box-shadow:
    0 0 25px
    rgba(168, 85, 247, 0.35);

  font-weight: 800;
}

.telegram-avatar {
  width: 44px;
  height: 44px;
}

/* HERO */

.hero {
  position: relative;
  overflow: hidden;

  padding: 27px 23px;
  margin-bottom: 28px;

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(168, 85, 247, 0.23),
      rgba(255, 255, 255, 0.045)
    );

  border: 1px solid
    rgba(255, 255, 255, 0.1);

  box-shadow:
    inset 0 1px 0
      rgba(255, 255, 255, 0.08);
}

.hero-glow {
  position: absolute;

  width: 180px;
  height: 180px;

  right: -60px;
  top: -90px;

  border-radius: 50%;

  background: var(--purple);

  filter: blur(75px);

  opacity: 0.35;
}

.hero-label {
  position: relative;

  color: var(--purple-light);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.hero h2 {
  position: relative;

  margin:
    10px 0
    8px;

  font-size: 29px;
  line-height: 1.08;

  letter-spacing: -0.04em;
}

.hero p {
  position: relative;

  margin: 0;

  color: #b5b5bf;
  line-height: 1.5;
}

/* SECTION */

.section-title {
  margin:
    0 0
    12px;

  color: #8f8f99;

  font-size: 13px;
  font-weight: 700;

  text-transform: uppercase;
  letter-spacing: 0.09em;
}

/* CARDS */

.route-card,
.service-card {
  width: 100%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 12px;
  padding: 19px;

  text-align: left;

  color: white;

  border:
    1px solid
    var(--border);

  border-radius: 21px;

  background:
    rgba(255, 255, 255, 0.045);

  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;

  cursor: pointer;
}

.route-card:active,
.service-card:active,
.primary-button:active {
  transform: scale(0.98);
}

.route-card:hover,
.service-card:hover {
  border-color:
    rgba(168, 85, 247, 0.55);

  box-shadow:
    0 0 25px
    rgba(168, 85, 247, 0.12);
}

.route-card h3,
.service-card h3 {
  margin: 0 0 7px;

  font-size: 17px;
}

.route-card p {
  margin: 0;

  color: var(--muted);
  font-size: 13px;
}

.arrow {
  font-size: 23px;
  color: var(--purple-light);
}

.service-card {
  min-height: 85px;
}

.price-vnd {
  display: block;

  font-size: 14px;
  font-weight: 700;

  color: #f4f4f6;
}

.price-rub {
  display: block;

  margin-top: 4px;

  color: var(--purple-light);
  font-size: 13px;
}

/* BACK */

.back-button {
  padding: 0;
  margin-bottom: 23px;

  border: 0;

  background: transparent;

  color: var(--purple-light);

  cursor: pointer;
}

/* FORM */

.subtitle {
  margin-top: 8px;
  margin-bottom: 25px;

  color: var(--muted);
}

.form {
  display: flex;
  flex-direction: column;
  gap: 17px;
}

.form label {
  display: flex;
  flex-direction: column;
  gap: 8px;

  font-size: 13px;
  color: #aaaab3;
}

input[type="text"],
input[type="date"],
input:not([type]) {
  width: 100%;

  padding: 15px;

  color: white;

  border:
    1px solid
    rgba(255, 255, 255, 0.1);

  outline: none;

  border-radius: 15px;

  background:
    rgba(255, 255, 255, 0.055);
}

input:focus {
  border-color:
    rgba(168, 85, 247, 0.8);

  box-shadow:
    0 0 0 3px
    rgba(168, 85, 247, 0.12);
}

/* CONSENT */

.consent {
  display: flex;

  gap: 10px;

  margin:
    22px 0;

  color: #aaaab3;

  font-size: 13px;
  line-height: 1.45;
}

.consent input {
  width: 19px;
  height: 19px;

  accent-color: var(--purple);

  flex: 0 0 auto;
}

.link-button {
  padding: 0;

  border: 0;

  background: none;

  color: var(--purple-light);

  text-decoration: underline;

  cursor: pointer;
}

/* BUTTON */

.primary-button {
  width: 100%;

  padding: 17px;

  border: 0;

  border-radius: 17px;

  color: white;

  font-weight: 800;

  background:
    linear-gradient(
      135deg,
      #a855f7,
      #7e22ce
    );

  box-shadow:
    0 10px 30px
    rgba(168, 85, 247, 0.24);

  cursor: pointer;
}

.primary-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* RECOMMENDATION */

.recommendation {
  margin:
    20px 0;

  padding: 18px;

  border-radius: 19px;

  background:
    rgba(255, 255, 255, 0.04);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.recommendation strong {
  color: var(--purple-light);
}

.recommendation p {
  color: #aaaab3;

  line-height: 1.5;

  font-size: 13px;
}

/* BUS */

.bus {
  margin:
    20px 0;

  padding: 16px;

  border-radius: 28px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid
    rgba(255, 255, 255, 0.1);
}

.bus-header {
  text-align: center;

  padding:
    12px;

  margin-bottom: 15px;

  color: var(--purple-light);

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 0.1em;

  border-bottom:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.bus-floor {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 8px;

  max-height: 510px;

  overflow-y: auto;
}

.seat {
  min-height: 52px;

  border:
    1px solid
    rgba(255, 255, 255, 0.1);

  border-radius: 14px;

  background:
    rgba(255, 255, 255, 0.055);

  color: white;

  cursor: pointer;
}

.seat.selected {
  background:
    linear-gradient(
      135deg,
      #a855f7,
      #7e22ce
    );

  border-color:
    rgba(216, 180, 254, 0.8);

  box-shadow:
    0 0 20px
    rgba(168, 85, 247, 0.4);
}

.seat.taken {
  opacity: 0.25;
  cursor: not-allowed;
}

.seat-legend {
  display: flex;

  justify-content: space-around;

  margin:
    10px 0 20px;

  color: #9999a3;

  font-size: 11px;
}

.seat-legend span {
  display: flex;

  align-items: center;

  gap: 6px;
}

.seat-legend i {
  width: 8px;
  height: 8px;

  display: inline-block;

  border-radius: 50%;
}

.free {
  background: #666;
}

.selected-dot {
  background: var(--purple);
}

.taken-dot {
  background: #333;
}

/* PAYMENT */

.timer-card {
  display: flex;

  justify-content: space-between;
  align-items: center;

  padding: 18px;

  margin:
    20px 0;

  border-radius: 19px;

  background:
    rgba(168, 85, 247, 0.12);

  border:
    1px solid
    rgba(168, 85, 247, 0.3);
}

.timer-card span {
  color: #aaaab3;
}

.timer-card strong {
  color: var(--purple-light);

  font-size: 26px;
  font-variant-numeric: tabular-nums;
}

.order-summary {
  display: flex;
  flex-direction: column;

  gap: 8px;

  padding: 19px;

  margin-bottom: 15px;

  border-radius: 19px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.order-summary span {
  color: #9a9aa5;

  font-size: 13px;
}

.order-summary strong:last-child {
  margin-top: 7px;

  color: var(--purple-light);

  font-size: 22px;
}

.payment-methods {
  display: flex;
  flex-direction: column;

  gap: 8px;

  margin-bottom: 16px;
}

.payment-method {
  display: flex;

  justify-content: space-between;
  align-items: center;

  padding: 16px;

  border-radius: 16px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.payment-method.active {
  border-color:
    rgba(168, 85, 247, 0.5);
}

.payment-method.disabled {
  color: #70707a;

  opacity: 0.65;
}

.payment-method small {
  padding:
    5px 9px;

  border-radius: 10px;

  background:
    rgba(255, 255, 255, 0.07);

  color: #9999a3;
}

.bank-card {
  padding: 20px;

  margin-bottom: 15px;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(168, 85, 247, 0.14),
      rgba(255, 255, 255, 0.04)
    );

  border:
    1px solid
    rgba(168, 85, 247, 0.25);
}

.bank-card > span {
  display: block;

  color: #9f9faa;

  font-size: 12px;
}

.bank-card > strong {
  display: block;

  margin:
    7px 0 20px;

  font-size: 28px;
}

.recipient {
  display: flex;

  justify-content: space-between;

  padding:
    13px 0;

  border-top:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-bottom:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.phone-row {
  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 10px;

  padding:
    15px 0;
}

.copy-button {
  padding:
    8px 11px;

  border-radius: 10px;

  border:
    1px solid
    rgba(168, 85, 247, 0.4);

  background:
    rgba(168, 85, 247, 0.1);

  color: var(--purple-light);

  cursor: pointer;
}

.upload-card {
  padding: 19px;

  margin-bottom: 15px;

  border-radius: 20px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.upload-card h3 {
  margin-top: 0;
}

.upload-card p {
  color: #9999a3;

  line-height: 1.45;

  font-size: 13px;
}

.file-selected {
  margin-top: 10px;

  color: #c084fc;

  font-size: 13px;
}

/* BOOKINGS */

.booking-card {
  padding: 18px;

  margin-bottom: 12px;

  border-radius: 20px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.booking-top {
  display: flex;

  justify-content: space-between;

  gap: 10px;
}

.booking-card p {
  color: #9999a3;
}

.booking-info {
  color: #aaaab3;

  font-size: 13px;
}

.booking-price {
  margin-top: 12px;

  color: var(--purple-light);

  font-weight: 800;
}

.status {
  padding:
    5px 8px;

  border-radius: 9px;

  background:
    rgba(168, 85, 247, 0.12);

  color: var(--purple-light);

  font-size: 10px;

  white-space: nowrap;
}

/* PROFILE */

.profile-card {
  display: flex;

  align-items: center;

  gap: 14px;

  padding: 20px;

  margin:
    20px 0;

  border-radius: 22px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.profile-avatar {
  width: 52px;
  height: 52px;
}

.profile-card strong,
.profile-card span {
  display: block;
}

.profile-card span {
  margin-top: 4px;

  color: #92929d;

  font-size: 13px;
}

.profile-section {
  margin-bottom: 15px;

  padding: 18px;

  border-radius: 19px;

  background:
    rgba(255, 255, 255, 0.04);

  border:
    1px solid
    rgba(255, 255, 255, 0.07);
}

.profile-section h3 {
  margin-top: 0;

  color: var(--purple-light);
}

.profile-row {
  display: flex;

  justify-content: space-between;

  gap: 15px;

  padding:
    12px 0;

  border-bottom:
    1px solid
    rgba(255, 255, 255, 0.06);
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-row span {
  color: #888892;
}

.profile-row strong {
  text-align: right;

  word-break: break-word;
}

.muted {
  color: #888892;

  line-height: 1.5;
}

/* LEGAL */

.legal-links {
  display: flex;
  flex-direction: column;

  gap: 5px;

  margin-top: 30px;
  padding-top: 20px;

  border-top:
    1px solid
    rgba(255, 255, 255, 0.07);
}

.legal-links button {
  padding: 10px 0;

  text-align: left;

  border: 0;

  background: transparent;

  color: #777782;

  font-size: 12px;

  cursor: pointer;
}

.legal-text {
  margin-top: 20px;

  padding: 20px;

  border-radius: 20px;

  background:
    rgba(255, 255, 255, 0.04);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  color: #b5b5be;

  line-height: 1.65;

  font-size: 13px;

  white-space: pre-wrap;
}

/* EMPTY */

.empty {
  text-align: center;

  padding: 70px 20px;
}

.empty-icon {
  font-size: 40px;

  color: var(--purple-light);

  margin-bottom: 15px;
}

.empty p {
  color: #888892;
}

/* BOTTOM NAV */

.bottom-bar {
  position: fixed;

  left: 50%;
  bottom:
    calc(12px + env(safe-area-inset-bottom));

  transform:
    translateX(-50%);

  width:
    min(420px, calc(100% - 24px));

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  padding: 8px;

  z-index: 100;

  border:
    1px solid
    rgba(255, 255, 255, 0.12);

  border-radius: 24px;

  background:
    rgba(20, 20, 26, 0.72);

  backdrop-filter:
    blur(28px)
    saturate(150%);

  -webkit-backdrop-filter:
    blur(28px)
    saturate(150%);

  box-shadow:
    0 15px 45px
    rgba(0, 0, 0, 0.45),
    inset 0 1px 0
      rgba(255, 255, 255, 0.1);
}

.bottom-bar button {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 3px;

  min-height: 58px;

  border: 0;

  border-radius: 18px;

  background: transparent;

  color: #777782;

  cursor: pointer;

  transition:
    all 0.2s ease;
}

.bottom-bar button span {
  font-size: 19px;
}

.bottom-bar button small {
  font-size: 10px;
}

.bottom-bar button.nav-active {
  color: #fff;

  background:
    rgba(168, 85, 247, 0.16);

  box-shadow:
    inset 0 0 20px
    rgba(168, 85, 247, 0.1),
    0 0 20px
    rgba(168, 85, 247, 0.08);
}

.bottom-bar button.nav-active span {
  color: var(--purple-light);
}

/* MOBILE */

@media (max-width: 400px) {

  .content {
    padding-left: 14px;
    padding-right: 14px;
  }

  h1 {
    font-size: 28px;
  }

  .hero h2 {
    font-size: 26px;
  }

  .phone-row {
    flex-direction: column;
    align-items: flex-start;
  }

}